# APEX Intelligence — Backend Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.

# ── REQUIRED ─────────────────────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model used by /analyze (change if a model is retired)
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── OPTIONAL (system degrades gracefully without these) ──────
# Get from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-key-here

# Get from: https://newsapi.org/register
NEWS_API_KEY=your-newsapi-key-here

# ── PRODUCTION CORS (comma-separated allowed origins) ────────
# Leave blank to allow all Vercel/Netlify/Railway/Render origins automatically
# Example: ALLOWED_ORIGINS=https://apex-intelligence.vercel.app,https://my-custom-domain.com
ALLOWED_ORIGINS=

# ── PORT (set automatically by Render/Railway) ────────────────
PORT=8000
